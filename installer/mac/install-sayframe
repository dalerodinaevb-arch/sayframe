#!/bin/bash
# Установщик Sayframe для After Effects (macOS). Один файл: панель лежит внутри него.
# Копирует панель в папку расширений Adobe текущего пользователя и включает
# загрузку панелей без подписи Adobe (PlayerDebugMode). Пароль администратора не нужен.

set -u
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
RES="$(cd "$SELF_DIR/../Resources" 2>/dev/null && pwd)"
SRC="$RES/Sayframe"
ICON="$RES/AppIcon.icns"
EXT_DIR="$HOME/Library/Application Support/Adobe/CEP/extensions"
DEST="$EXT_DIR/Sayframe"
TMP_DEST="$EXT_DIR/.Sayframe.installing"
OLD="$EXT_DIR/ClaudePanel"        # прежнее название панели
AUTO="${SAYFRAME_YES:-0}"          # SAYFRAME_YES=1 — без окон, для проверки
ACTION="${SAYFRAME_ACTION:-}"      # install | remove (только вместе с SAYFRAME_YES=1)
TITLE="Sayframe для After Effects"
NL='
'

# dialog <текст> <кнопка отмены или ""> <кнопка>...  -> печатает нажатую кнопку
dialog() {
    local text="$1" cancel="$2"
    shift 2
    if [ "$AUTO" = "1" ]; then
        echo "[$*] $text"
        return 0
    fi
    local out
    if out="$(rich_dialog "$text" "$cancel" "$@" 2>/dev/null)"; then
        echo "$out"
        return 0
    fi
    # Запасной вариант: самое простое окно, если оформленное не открылось.
    local last=""
    for last in "$@"; do :; done
    if [ -n "$cancel" ]; then
        /usr/bin/osascript -e 'on run a' -e 'try' -e 'return button returned of (display dialog (item 1 of a) buttons {item 2 of a, item 3 of a} default button 2)' -e 'end try' -e 'return item 2 of a' -e 'end run' "$text" "$cancel" "$last" 2>/dev/null
    else
        /usr/bin/osascript -e 'on run a' -e 'display dialog (item 1 of a) buttons {item 2 of a} default button 1' -e 'return item 2 of a' -e 'end run' "$text" "$last" 2>/dev/null
    fi
}

rich_dialog() {
    local text="$1" cancel="$2"
    shift 2
    /usr/bin/osascript - "$text" "$TITLE" "$ICON" "$cancel" "$@" <<'APPLESCRIPT'
on run argv
    set msg to item 1 of argv
    set ttl to item 2 of argv
    set ico to item 3 of argv
    set cancelName to item 4 of argv
    set btns to items 5 thru -1 of argv
    if cancelName is not "" then set btns to {cancelName} & btns
    try
        activate
    end try
    try
        try
            if cancelName is "" then
                set r to display dialog msg with title ttl buttons btns default button (count of btns) with icon (POSIX file ico)
            else
                set r to display dialog msg with title ttl buttons btns default button (count of btns) cancel button 1 with icon (POSIX file ico)
            end if
        on error number errNum
            if errNum is -128 then error number -128
            if cancelName is "" then
                set r to display dialog msg with title ttl buttons btns default button (count of btns)
            else
                set r to display dialog msg with title ttl buttons btns default button (count of btns) cancel button 1
            end if
        end try
    on error number -128
        return cancelName
    end try
    return button returned of r
end run
APPLESCRIPT
}

fail() {
    dialog "$1" "" "Закрыть" >/dev/null
    exit 1
}

ae_note() {
    if pgrep -f "Adobe After Effects" >/dev/null 2>&1; then
        echo "After Effects сейчас открыт: сохраните проект, полностью закройте программу и откройте снова."
    else
        echo "Откройте After Effects."
    fi
}

do_install() {
    mkdir -p "$EXT_DIR" 2>/dev/null || fail "Не удалось создать папку расширений Adobe:${NL}$EXT_DIR"

    # Сначала копируем во временную папку: если копирование сорвётся, прежняя версия останется целой.
    rm -rf "$TMP_DEST" 2>/dev/null
    if ! cp -R "$SRC" "$TMP_DEST" 2>/dev/null || [ ! -f "$TMP_DEST/CSXS/manifest.xml" ]; then
        rm -rf "$TMP_DEST" 2>/dev/null
        fail "Не удалось скопировать панель в папку:${NL}$EXT_DIR${NL}${NL}Ничего не изменено."
    fi
    if [ -e "$DEST" ] && ! rm -rf "$DEST" 2>/dev/null; then
        rm -rf "$TMP_DEST" 2>/dev/null
        fail "Не удалось заменить прежнюю версию панели:${NL}$DEST"
    fi
    if ! mv "$TMP_DEST" "$DEST" 2>/dev/null; then
        fail "Не удалось поместить панель в папку:${NL}$DEST"
    fi
    # Снимаем метку «скачано из интернета» с файлов панели.
    xattr -dr com.apple.quarantine "$DEST" 2>/dev/null
    if [ -e "$OLD" ]; then
        rm -rf "$OLD" 2>/dev/null
    fi

    # Разрешаем After Effects загружать панели без подписи Adobe (все версии движка панелей).
    local failed=0 v
    for v in 9 10 11 12 13 14 15 16; do
        defaults write "com.adobe.CSXS.$v" PlayerDebugMode 1 2>/dev/null || failed=1
    done
    if [ "$failed" = "1" ]; then
        fail "Панель скопирована, но не удалось включить настройку PlayerDebugMode, без неё After Effects панель не покажет.${NL}${NL}Откройте «Терминал» и выполните:${NL}defaults write com.adobe.CSXS.12 PlayerDebugMode 1"
    fi

    dialog "Sayframe установлен.${NL}${NL}$(ae_note)${NL}Панель находится в меню:${NL}Window > Extensions > Sayframe${NL}${NL}Для референсов и вставки картинок включите в After Effects:${NL}Settings > Scripting & Expressions > Allow Scripts to Write Files and Access Network" "" "Готово" >/dev/null
    exit 0
}

do_remove() {
    if ! rm -rf "$DEST" 2>/dev/null || [ -e "$DEST" ]; then
        fail "Не удалось удалить папку панели:${NL}$DEST"
    fi
    dialog "Sayframe удалён.${NL}${NL}Перезапустите After Effects, чтобы панель исчезла из меню. Настройка PlayerDebugMode не тронута: она может быть нужна другим панелям." "" "Готово" >/dev/null
    exit 0
}

if [ ! -f "$SRC/CSXS/manifest.xml" ]; then
    fail "Установщик повреждён: внутри нет файлов панели. Скачайте его заново."
fi

if [ "$AUTO" = "1" ]; then
    case "$ACTION" in
        remove) do_remove ;;
        *)      do_install ;;
    esac
fi

if [ -e "$DEST" ]; then
    CHOICE="$(dialog "Sayframe уже установлен.${NL}${NL}Переустановить (заменить установленную версию этой) или удалить панель?" "Отмена" "Удалить" "Переустановить")"
    case "$CHOICE" in
        "Переустановить") do_install ;;
        "Удалить")        do_remove ;;
        *)                exit 0 ;;
    esac
fi

EXTRA=""
if [ -e "$OLD" ]; then
    EXTRA="${NL}• удалит прежнюю версию этой панели (папку ClaudePanel)"
fi
CHOICE="$(dialog "Установить панель Sayframe в After Effects?${NL}${NL}Установщик:${NL}• скопирует панель в папку расширений Adobe в вашей домашней папке${NL}• разрешит After Effects загружать панели без подписи Adobe (настройка PlayerDebugMode)${EXTRA}${NL}${NL}Пароль не потребуется." "Отмена" "Установить")"
if [ "$CHOICE" = "Установить" ]; then
    do_install
fi
exit 0
